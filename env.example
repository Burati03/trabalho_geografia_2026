# Copie para .env
FIRMS_MAP_KEY=            # chave gratuita: https://firms.modaps.eosdis.nasa.gov/api/area/
VITE_CARTO_MAP_KEY=       # opcional: chave do basemap CARTO para usar o estilo voyager
ADMIN_TOKEN=troque-este-token
SEED_DEMO=0               # somente use 1 em testes locais; em produção mantenha 0 para evitar dados sintéticos
